<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_conversations">

    <!-- First-launch identity creation. MainActivity overrides the
         graph's start destination at runtime to point here instead of
         conversations whenever PreferenceRepository.isOnboarded() is
         false; navigation back to conversations happens inside the
         fragment via popUpTo. -->
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.qubee.messenger.ui.onboarding.OnboardingFragment"
        android:label="Welcome" />

    <fragment
        android:id="@+id/navigation_conversations"
        android:name="com.qubee.messenger.ui.main.ConversationsFragment"
        android:label="Chats"
        tools:layout="@layout/fragment_conversations">
        <action
            android:id="@+id/action_to_chat"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_to_contact_selection"
            app:destination="@id/contactSelectionFragment" />
        <action
            android:id="@+id/action_to_group_invite"
            app:destination="@id/groupInviteFragment" />
        <action
            android:id="@+id/action_to_connect"
            app:destination="@id/connectFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_contacts"
        android:name="com.qubee.messenger.ui.contacts.ContactsFragment"
        android:label="Contacts"
        tools:layout="@layout/fragment_contacts">
        <action
            android:id="@+id/action_contact_to_chat"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_contact_to_add_contact"
            app:destination="@id/addContactFragment" />
        <action
            android:id="@+id/action_contact_to_connect"
            app:destination="@id/connectFragment" />
    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.qubee.messenger.ui.settings.SettingsFragment"
        android:label="Settings">
        <action
            android:id="@+id/action_settings_to_connect"
            app:destination="@id/connectFragment" />
    </fragment>

    <!-- "Add someone": the user's own code to be scanned, the scanner
         for the other phone's code, and the two discovery routes. -->
    <fragment
        android:id="@+id/connectFragment"
        android:name="com.qubee.messenger.ui.connect.ConnectFragment"
        android:label="Add someone">
        <action
            android:id="@+id/action_connect_to_add_contact"
            app:destination="@id/addContactFragment" />
        <action
            android:id="@+id/action_connect_to_settings"
            app:destination="@id/navigation_settings" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.qubee.messenger.ui.chat.ChatFragment"
        android:label="Chat">
        <argument
            android:name="contactId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/contactSelectionFragment"
        android:name="com.qubee.messenger.ui.contacts.ContactSelectionFragment"
        android:label="Choose contact">
        <action
            android:id="@+id/action_selection_to_chat"
            app:destination="@id/chatFragment"
            app:popUpTo="@id/contactSelectionFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_selection_to_connect"
            app:destination="@id/connectFragment" />
    </fragment>

    <!-- Group invite / scan flow. The {token} placeholder lets Navigation
         match the full `qubee://invite/<token>` URI; the fragment reads
         the original Intent (and thus the full link) via
         `NavController.KEY_DEEP_LINK_INTENT` rather than relying on an
         out-of-band activity-side handler. -->
    <fragment
        android:id="@+id/groupInviteFragment"
        android:name="com.qubee.messenger.ui.groups.GroupInviteFragment"
        android:label="Group invite">
        <deepLink app:uri="qubee://invite/{token}" />
    </fragment>

    <!-- Adding a contact from a scanned/pasted qubee://identity/... link.
         Reached by deep link, or with a "link" argument from the scanner
         on the Add someone screen. -->
    <fragment
        android:id="@+id/addContactFragment"
        android:name="com.qubee.messenger.ui.contacts.AddContactFragment"
        android:label="Add contact">
        <argument
            android:name="link"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <deepLink app:uri="qubee://identity/{token}" />
        <!-- Saving opens the new chat; Back from there must not return
             to a preview that has already been saved. -->
        <action
            android:id="@+id/action_add_contact_to_chat"
            app:destination="@id/chatFragment"
            app:popUpTo="@id/addContactFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_add_contact_to_connect"
            app:destination="@id/connectFragment" />
    </fragment>

</navigation>

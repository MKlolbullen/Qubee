# ─────────────────────────────────────────────────────────────
# Rust
# ─────────────────────────────────────────────────────────────
/target/
**/*.rs.bk
Cargo.lock.bak
*.profraw
*.profdata
lcov.info
coverage/

# Keep Cargo.lock committed: Qubee is an application and release builds
# should resolve the exact dependency graph reviewed in CI.

# ─────────────────────────────────────────────────────────────
# Gradle / Android
# ─────────────────────────────────────────────────────────────
.gradle/
build/
**/build/
local.properties
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.hprof
*.trace
hs_err_pid*
replay_pid*

# Rust JNI libraries are reproducible build outputs generated by
# build_rust.sh / build_rust.ps1 and by release CI. Do not commit them.
/app/src/main/jniLibs/

# Room schema snapshots are intentionally NOT ignored. Once generated they
# are migration-review material and should be committed under app/schemas/.

# Paparazzi failure output is regenerated by the next test run.
app/build/paparazzi/failures/

# ─────────────────────────────────────────────────────────────
# Signing material / local secrets
# ─────────────────────────────────────────────────────────────
*.jks
*.jks.b64
*.keystore
*.p12
*.pfx
*.pkcs12
keystore.properties
.env
.env.*
!.env.example
.secrets/
secrets/
credentials/
private/

# Do not globally ignore *.pem / *.crt: public test certificates and
# protocol vectors may legitimately belong in a cryptography repository.

# ─────────────────────────────────────────────────────────────
# Runtime state
# ─────────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
*.pid

# ─────────────────────────────────────────────────────────────
# IntelliJ / Android Studio
# ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws

# ─────────────────────────────────────────────────────────────
# Editor / OS noise
# ─────────────────────────────────────────────────────────────
*.swp
*.swo
*.tmp
*.temp
*~
*.bak
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini
